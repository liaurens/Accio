inputFile                         : USAIN
toolVersion                       : 4.10.0

<START>

structureInpFilePath              :
site                              : offshore
flangeType                        : L
zFlange                           : -19.88
diameter                          : 7000
diameterReference                 : outneck
thicknNoseUp                      : 60
thicknNoseLo                      : 60
heightNoseUp                      :
heightNoseLo                      :

boltOptions                       : ISO_M48 ISO_M56 ISO_M64
minNBolts                         : 140
maxNBolts                         : 144
minFlangeWidth                    : 360
maxFlangeWidth                    : 370
minFlangeThickn                   : 160
maxFlangeThickn                   : 170

tighteningMethod                  : tension
diamBoltHole                      :
diamBoltCircle                    :
lengthBoltExtender                :

Loads.tag                         : 'deep-soft'
Loads.flsFilePath                 :
Loads.flsScalingFactor            : 1.05 1.05
Loads.flsScalingLevel             : -200 200
Loads.S1FilePath                  :
Loads.S1ScalingFactor             : 1.02 1.02
Loads.S1ScalingLevel              : -200 200
Loads.ulsFilePath                 :
Loads.ulsScalingFactor            : 1.05 1.05
Loads.ulsScalingLevel             : -200 200
Loads.inclinationValue            : 0.75
Loads.inclinationValueFls         : 0.125
Loads.inclinationUnit             : deg
Loads.dlcFilter                   :

Loads.tag                         : 'shallow-stiff'  % To test multiple load sets
Loads.flsFilePath                 :
Loads.flsScalingFactor            : 1.00 1.00
Loads.flsScalingLevel             : -200 200
Loads.S1FilePath                  :
Loads.S1ScalingFactor             : 0.98 0.98
Loads.S1ScalingLevel              : -200 200
Loads.ulsFilePath                 :
Loads.ulsScalingFactor            : 1.00 1.00
Loads.ulsScalingLevel             : -200 200
Loads.inclinationValue            : 10
Loads.inclinationValueFls         : 0
Loads.inclinationUnit             : mm_m
Loads.dlcFilter                   : 'DLC62'  % To test the dlcFilter input

BoltFls.BOLT_FORCE_MODEL          : schmidtneuper
BoltFls.CUSTOM_PRELOAD            :
BoltFls.PRELOAD_LOSS_FACTOR_FLS   : 0.90
BoltFls.PSF_BOLT_MATERIAL_FLS     : 1.25
BoltFls.SN_CURVE_BOLT             : EC3_DC36*
BoltFls.THICKNESS_EXPONENT_BOLT   : 0.25
BoltFls.TARGET_PM_SUM             : 0.90

BoltFls.BOLT_FORCE_MODEL          : sgre2
BoltFls.CUSTOM_PRELOAD            : 1900 2450 1234
BoltFls.PRELOAD_LOSS_FACTOR_FLS   : 0.90
BoltFls.PSF_BOLT_MATERIAL_FLS     : 1.10
BoltFls.SN_CURVE_BOLT             : EC3_DC50
BoltFls.THICKNESS_EXPONENT_BOLT   : 0.10
BoltFls.TARGET_PM_SUM             : 1.00

SGRE2.BENDING_CONTRIBUTION        : 0.50
SGRE2.FLANGE_TILT_UNIT            : deg
SGRE2.FLANGE_TILT_VALUE           : 0.5
SGRE2.FLATNESS_TOLERANCE          : 1.4
SGRE2.GAP_ANGLE                   : 30 60 90 120
SGRE2.INITIAL_POINT_OFFSET        : 0.05
SGRE2.INITIAL_SLOPE_REFERENCE_PRELOAD : 0.2
SGRE2.SHELL_STIFFNESS_METHOD      : interpolated
SGRE2.WRITE_INTERMEDIATE_RESULTS  : true

targetDir                         :
runName                           : dummy_for_tests

<END>
