classdef {{ tool_name }} < ToolBasis % mh:ignore_style
    % {{ tool_name }} - {{ description }}
    %
    % Usage:
    %   {{ tool_name }}.copy_inputfiles(targetDir)  - Create sample input file
    %   {{ tool_name }}.run(inputFilePath)          - Run the tool
    %   {{ tool_name }}.do_input_checks(inputFile)  - Validate inputs only
    %   {{ tool_name }}.changelog()                 - Show version history
    %
    % See also ToolBasis

    properties (Constant)
        VERSION = '{{ version }}'
    end

    properties (Constant, Hidden)
        TOOL_NAME = '{{ tool_name }}'
    end

    properties
        Mdl     % Main model object
    end

    methods

        function Obj = {{ tool_name }}(varargin)
            % Constructor
            if nargin
                Obj = assign_varargin_2_classprop(Obj, varargin{:});
            end
        end

        % ========================= INPUT PROCESSING =========================

        function read_parse_validate_inputfile(Obj, inputFilePath, doSkipVoid)
            % Reads input file and applies validation

            if nargin < 3
                doSkipVoid = false;
            end

            Obj.info('Parsing input file %s ...', inputFilePath);

            % Load the input file
            Obj.Inp = InputFile(inputFilePath);
            Obj.Inp.targetFilePath = inputFilePath;
            Obj.Inp.skipVoid = doSkipVoid;

            % Expand paths
            varNames = {"targetDir"};
            inpfilehelper.expand_and_resolve_paths(Obj.Inp, varNames);

            % Check for deprecated inputs
            map = Obj.define_deprecated_mapping();
            Obj.Inp = Deprecated.check_for_deprecate_inputs(map, Obj.Inp);

            % Apply schema validation (uncomment when schema is defined)
            % Schema = {{ tool_package }}.inputs.get_schema();
            % fieldNamesWithDefault = Schema.get_field_names_with_default();
            % Obj.check_inputlist_with_latest_template(fieldNamesWithDefault, []);
            % fAssignAs = @(varName) ['Inps.', varName];
            % Obj.Inp = validate.apply_schema_to_inputfile(Schema, Obj.Inp, fAssignAs);

            Obj.parse_and_assign_inputs();
            Obj.check_for_unknown_inputs();

            Obj.info('Input validation complete.\n');
        end

        function do_post_parse_manipulations(Obj)
            % Data transformations after parsing

            % Default target directory
            if strcmp(Obj.Inputs.targetDir, '')
                Obj.Inputs.targetDir = char(pathlib.Path(Obj.Inp.sourceFilePath).parent / 'Res');
            end

            Obj.create_target_dir();
            Obj.move_log_file();
        end

        function do_post_parse_checks(Obj)
            % Validation checks after parsing
            % Add custom assertions here
        end

        % ========================= EXECUTION =========================

        function varargout = execute_tool(Obj, varargin)
            % Main execution using SequentialRunner

            Obj.process_inputs(varargin{1}, false);

            Runner = runner.SequentialRunner();

            % Set up data keys (uncomment when DataKeys is defined)
            % Runner.set({{ tool_package }}.DataKeys.Inputs, Obj.Inputs);

            % Add processing steps (uncomment when steps are defined)
            % Runner.add( ...
            %     {{ tool_package }}.io.LoadExternalFilesStep(), ...
            %     {{ tool_package }}.model.MainModelStep(), ...
            %     {{ tool_package }}.io.WriteFilesStep() ...
            % );

            % Runner.run();

            % Prepare output
            OutData = struct();

            if nargout > 0
                varargout = {Obj, OutData};
            end
        end

    end

    methods (Static, Hidden)

        function templFilePaths = get_template_path()
            templFilePaths = get_template_path@ToolBasis({{ tool_name }}.TOOL_NAME);
        end

        function map = define_deprecated_mapping()
            % Define deprecated input mappings: {'OldName', 'NewName'}
            map = containers.Map();
        end

    end

    methods (Static)

        function varargout = copy_inputfiles(targetDir)
            % Create sample input file in target directory
            %
            % Syntax:
            %   filePath = {{ tool_name }}.copy_inputfiles(targetDir)

            narginchk(0, 1);

            if nargin < 1
                targetDir = input('Target directory:\n', 's');
            end

            toolName = mfilename('class');
            targetFilePath = copy_inputfiles@ToolBasis(toolName, targetDir);

            fprintf('\nCreated input file:\n  %s\n', targetFilePath);

            if nargout
                varargout{1} = targetFilePath;
            end
        end

        function do_input_checks(inputFilePath)
            % Validate inputs without running the tool

            Obj = {{ tool_name }}();
            Obj.config_logger();
            Obj.process_inputs(inputFilePath, false);
        end

        function varargout = run(inputFilePath)
            % Run the tool from input file
            %
            % Syntax:
            %   [OutData, Obj] = {{ tool_name }}.run(inputFilePath)

            Obj = {{ tool_name }}();
            Obj.config_logger();

            [Obj, OutData] = Obj.execute(inputFilePath);

            Obj.info('Run complete. Results in: %s\n', Obj.Inputs.targetDir);

            if nargout > 0
                varargout = {OutData, Obj};
            end
        end

        function changelog()
            % Display version history
            toolName = mfilename('class');
            ToolBasis.pprint_changelog(toolName);
        end

    end

end
